# ── Merkevare og domene (kan endres uten kodeendring) ─────────────
NEXT_PUBLIC_SITE_NAME="TULL ELLER TALL?"
NEXT_PUBLIC_SITE_SHORT_NAME="Tull eller tall"
NEXT_PUBLIC_SITE_URL=https://tulltall.no
NEXT_PUBLIC_CONTACT_EMAIL=redaksjon@tulltall.no
# Første publiserte runde (brukes til rundenummer)
NEXT_PUBLIC_LAUNCH_DATE=2026-11-01

# ── Database ──────────────────────────────────────────────────────
# Supabase/PostgreSQL i produksjon. Bruk «transaction pooler»-URL-en (port 6543) på Vercel.
# Tom = lokal PGlite (Postgres i WebAssembly) i .data/pglite med automatisk migrering og seed.
DATABASE_URL=
# POSTGRES_URL brukes automatisk hvis DATABASE_URL er tom (settes av Vercels Supabase-integrasjon).
# TLS: standard er kryptert forbindelse uten CA-verifisering. For full verifisering, lim inn
# Supabase-sertifikatet i PGSSL_CA (eller sett PGSSL=verify for offentlig signerte sertifikater).
# PGSSL_CA=
# PGSSL=disable      # bare for lokal Postgres uten TLS
# PGLITE_DIR=.data/pglite
# Migrer og seed automatisk ved første forespørsel (anbefalt for enkel Vercel-oppsett)
AUTO_MIGRATE=false

# ── Sikkerhet ─────────────────────────────────────────────────────
# Lang tilfeldig streng (minst 24 tegn). Signerer økter og admin-innlogging. Generer f.eks. med: openssl rand -base64 48
SESSION_SECRET=
# Passord til /admin (minst 10 tegn). Admin er avslått hvis tomt.
ADMIN_PASSWORD=
# Beskytter /api/cron/daily (Vercel Cron sender «Authorization: Bearer <CRON_SECRET>»)
CRON_SECRET=
# Minste tid (ms) mellom to svar i samme økt (mot automatisering)
MIN_ANSWER_MS=350
# Antall fullførte runder før «bedre enn X %» vises
COMPARISON_MIN_PLAYERS=30
# Hemmelig salt for rotasjonsalgoritmen (valgfritt)
ROTATION_SALT=

# ── Claude API (KI-redaksjon i ukentlig jobb) ─────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ── SSB ───────────────────────────────────────────────────────────
SSB_API_BASE=https://data.ssb.no/api/pxwebapi/v2

# ── Varsler ved feil i automatiseringen (Slack-kompatibel webhook) ─
ALERT_WEBHOOK_URL=

# ── Web Push (generer med: npm run vapid) ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:redaksjon@tulltall.no

# ── Annonser (Google AdSense) – av som standard ───────────────────
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_PAGE=
